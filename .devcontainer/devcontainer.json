{
  "name": "moodle-deisi",
  // The universal Codespaces image already ships Docker (docker-in-docker).
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 4 },
  "forwardPorts": [80],
  "portsAttributes": {
    "80": { "label": "Moodle", "onAutoForward": "openBrowser" }
  },
  "postStartCommand": "bash .devcontainer/start.sh"
}
